# Credenciais de SMTP — nunca versionar.
# O modelo versionado é api/auth/mail_config.example.php.
api/auth/mail_config.php

# Chave da API da Anthropic (motor híbrido da rede de agentes).
# O modelo versionado é api/ai/ai_config.example.php.
api/ai/ai_config.php

# Chaves das plataformas de geração de vídeo.
# O modelo versionado é api/video/video_config.example.php.
api/video/video_config.php

# Credenciais do banco — nunca versionar.
# O modelo versionado é api/auth/db_config.example.php.
api/auth/db_config.php

# Credenciais OAuth do login com Google — nunca versionar.
# O modelo versionado é api/auth/google_config.example.php.
api/auth/google_config.php

# Log de e-mail do driver de desenvolvimento.
logs/

# Avatares e imagens enviados pelos usuários.
uploads/*
!uploads/.gitkeep
# A trava que impede o Apache de executar PHP dentro da pasta de upload
# PRECISA ser versionada: ela e codigo de seguranca, nao arquivo enviado.
# Sem esta excecao, toda instalacao nova nasce com uploads/ executavel.
!uploads/.htaccess

# Estrutura de pastas dos vídeos gerados — versiona só a árvore
# (.gitkeep), nunca o .mp4 enviado. `uploads/*` acima já ignora
# `uploads/videos` inteiro; cada nível precisa da própria exceção.
!uploads/videos/
!uploads/videos/lojas/
!uploads/videos/lojas/.gitkeep

# Avatares de agente de usuário (upload) — os SVG fixos dos seis agentes
# de sistema, sem prefixo "user_", continuam versionados.
assets/ai/avatares/user_*

# Scripts temporarios de migracao gerados durante o trabalho.
.tmp_*.py

# Logs do ambiente de teste local (mysqld, php -S).
mysql_start.log
php_server*.log

# Capturas de tela das rodadas de teste mobile: 81 PNGs, 15 MB, e cada
# rodada nova soma outro tanto. Os relatórios e os dados brutos (.md e
# .json) continuam versionados — é neles que está a leitura. As imagens
# ficam só na máquina de quem rodou o teste.
testes_mobile/**/*.png

# Dumps do banco local feitos antes de migracao. Contem e-mail de usuario
# real — nunca versionar.
backup_*.sql
