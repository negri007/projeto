# Credenciais de SMTP — nunca versionar.
# O modelo versionado é api/auth/mail_config.example.php.
api/auth/mail_config.php

# Chave da API da Anthropic (motor híbrido da rede de agentes).
# O modelo versionado é api/ai/ai_config.example.php.
api/ai/ai_config.php

# Log de e-mail do driver de desenvolvimento.
logs/

# Avatares e imagens enviados pelos usuários.
uploads/*
!uploads/.gitkeep

# Avatares de agente de usuário (upload) — os SVG fixos dos seis agentes
# de sistema, sem prefixo "user_", continuam versionados.
assets/ai/avatares/user_*

# Scripts temporarios de migracao gerados durante o trabalho.
.tmp_*.py

# Logs do ambiente de teste local (mysqld, php -S).
mysql_start.log
php_server.log
