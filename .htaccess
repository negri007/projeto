# Headers de seguranca para as paginas estaticas (.html).
#
# Os endpoints de API ja recebem estes headers de api/bootstrap.php, que
# roda em PHP; arquivos .html sao servidos direto pelo Apache, sem passar
# por PHP, e por isso ficavam sem protecao nenhuma. O escopo e .html de
# proposito: aplicar global somaria um segundo X-Frame-Options as respostas
# PHP que ja o tem, e dois valores do mesmo header confundem o navegador.
#
# X-Frame-Options: DENY  -> a UI logada nao pode ser embutida em iframe de
# outra origem (defesa contra clickjacking).
# ---------------------------------------------------------------------
# O que NÃO é site (28/09/2026)
#
# A pasta do projeto é o DocumentRoot, então tudo o que mora nela era
# baixável por URL — inclusive dumps do banco (e-mails, hashes de senha,
# conversas), `logs/mail.log` (links de redefinição de senha ainda
# válidos = tomar a conta de alguém), o histórico do git e as anotações
# internas. Nada disso é chamado pelo front.
#
# Arquivos por extensão/nome: `Require` é do mod_authz_core, que o Apache
# sempre carrega.
<FilesMatch "(\.(sql|md|log|sh|bak|ini|lock|env)|^package(-lock)?\.json|^\.git.*)$">
    Require all denied
</FilesMatch>

# Pastas inteiras. O RewriteRule casa o caminho relativo a ESTE arquivo,
# então vale com o projeto na raiz do host ou numa subpasta.
# `uploads/turmas/` é material de aula privado: sai só por
# api/turmas/material_arquivo.php, que confere a turma a cada pedido.
# `api/ai/nucleo/` são as partes do helpers da rede de IA: só definem
# funções, nunca são endpoint, e só entram via api/ai/helpers.php.
# `tools/` são scripts de linha de comando (verificação), nunca site.
#
# Sob `php -S` nada deste arquivo vale (ver o .htaccess de uploads/).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.git|\.claude|docs|logs|testes_mobile|motor|uploads/turmas|api/ai/nucleo|tools)(/|$) - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header always set X-Frame-Options "DENY"
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        # Sem isto o navegador guardava a página por heurística e seguia
        # pedindo o echo-ui.js?v= antigo: o `?v=` dos scripts só funciona
        # se o HTML que o cita for revalidado. `no-cache` não proíbe o
        # cache -- obriga a conferir o ETag, que custa um 304 quando nada mudou.
        Header always set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
